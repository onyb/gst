{
  "$schema": "../section.schema.json",
  "section": "supeco",
  "return": "gstr1",
  "title": "Supplies through an e-commerce operator - 14",
  "provenance": {
    "offline_tool": "V3.2.4",
    "excel_template": "GSTR1_Excel_Workbook_Template_V2.2.xlsx",
    "csv_template": "Section_wise_CSV_files/GSTR1/eco.csv",
    "verified_on": "2026-07-26"
  },
  "source": {
    "excel": {
      "sheet": "eco",
      "header_row": 4,
      "first_data_row": 5
    },
    "csv": {
      "file": "eco.csv",
      "header_row": 1
    }
  },
  "fields": [
    {
      "id": "nat_supp",
      "column": "Nature of Supply",
      "order": 0,
      "type": "text",
      "required": true,
      "enum": [
        "Liable to collect tax u/s 52(TCS)",
        "Liable to pay tax u/s 9(5)"
      ],
      "description": "Whether the operator collects tax under section 52 or pays it under section 9(5). Selects which member of the payload object the row lands in, and is not itself emitted."
    },
    {
      "id": "etin",
      "column": "GSTIN of E-Commerce Operator",
      "order": 1,
      "type": "gstin",
      "required": true,
      "accepts": [
        "eco"
      ],
      "description": "The e-commerce operator's registration."
    },
    {
      "id": "cname",
      "column": "E-Commerce Operator Name",
      "order": 2,
      "type": "text",
      "required": false,
      "pattern": "^[a-zA-Z0-9_&'\\-./,()?@!#%$~*;+= ]{1,99}$",
      "max_length": 99,
      "description": "Operator's trade name. Stripped before upload, like every other counterparty name."
    },
    {
      "id": "suppval",
      "column": "Net value of supplies",
      "order": 3,
      "type": "decimal",
      "required": true,
      "pattern": "^(\\d{0,13})(\\.\\d{0,2})?$",
      "round_to": 2,
      "description": "Net value of supplies made through the operator."
    },
    {
      "id": "igst",
      "column": "Integrated tax",
      "order": 4,
      "type": "decimal",
      "required": false,
      "default": 0,
      "pattern": "^-?(\\d{0,11})(\\.\\d{0,2})?$",
      "round_to": 2,
      "description": "Integrated tax on those supplies. Entered directly rather than derived from a rate."
    },
    {
      "id": "cgst",
      "column": "Central tax",
      "order": 5,
      "type": "decimal",
      "required": false,
      "default": 0,
      "pattern": "^-?(\\d{0,11})(\\.\\d{0,2})?$",
      "round_to": 2,
      "description": "Central tax on those supplies. Entered directly rather than derived from a rate."
    },
    {
      "id": "sgst",
      "column": "State/UT tax",
      "order": 6,
      "type": "decimal",
      "required": false,
      "default": 0,
      "pattern": "^-?(\\d{0,11})(\\.\\d{0,2})?$",
      "round_to": 2,
      "description": "State/UT tax on those supplies. Entered directly rather than derived from a rate."
    },
    {
      "id": "cess",
      "column": "Cess",
      "order": 7,
      "type": "decimal",
      "required": false,
      "default": 0,
      "pattern": "^-?(\\d{0,11})(\\.\\d{0,2})?$",
      "round_to": 2,
      "description": "Cess on those supplies. Entered directly rather than derived from a rate."
    }
  ],
  "rules": [],
  "grouping": {},
  "output": {
    "record": {
      "keys": [
        {
          "key": "etin",
          "from": "field:etin"
        },
        {
          "key": "suppval",
          "from": "field:suppval"
        },
        {
          "key": "igst",
          "from": "field:igst"
        },
        {
          "key": "cgst",
          "from": "field:cgst"
        },
        {
          "key": "sgst",
          "from": "field:sgst"
        },
        {
          "key": "cess",
          "from": "field:cess"
        }
      ]
    },
    "member_from": {
      "field": "nat_supp",
      "map": {
        "Liable to collect tax u/s 52(TCS)": "clttx",
        "Liable to pay tax u/s 9(5)": "paytx"
      }
    },
    "derivations": [],
    "derivation_notes": {}
  },
  "notes": [
    {
      "kind": "quirk",
      "text": "ONE SHEET FEEDS TWO MEMBERS of the payload object: Nature of Supply routes each row to 'clttx' (tax collected under section 52) or 'paytx' (tax paid under section 9(5)). The column itself is never emitted \u2014 it only decides where the record goes. No other section in the return splits this way.",
      "affects": [
        "nat_supp",
        "output"
      ]
    },
    {
      "kind": "quirk",
      "text": "Tax amounts are entered directly rather than derived from a rate: there is no Rate column and no line items at all. The reference requires the amounts to agree in sign with the net value.",
      "affects": [
        "igst",
        "cgst",
        "sgst",
        "cess"
      ]
    },
    {
      "kind": "quirk",
      "text": "The operator name reaches the working file but is stripped before upload, exactly as the recipient name is for B2B and credit notes.",
      "affects": [
        "cname"
      ]
    }
  ]
}
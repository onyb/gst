{
  "$schema": "../section.schema.json",
  "section": "ecomaurp2c",
  "return": "gstr1",
  "title": "Amended supplies under section 9(5) by unregistered suppliers to unregistered persons - 15A",
  "provenance": {
    "offline_tool": "V3.2.4",
    "excel_template": "GSTR1_Excel_Workbook_Template_V2.2.xlsx",
    "csv_template": "Section_wise_CSV_files/GSTR1/ecoaurp2c.csv",
    "verified_on": "2026-07-26"
  },
  "source": {
    "excel": {
      "sheet": "ecoaurp2c",
      "header_row": 4,
      "first_data_row": 5
    },
    "csv": {
      "file": "ecoaurp2c.csv",
      "header_row": 1
    }
  },
  "fields": [
    {
      "id": "fy",
      "column": "Financial Year",
      "order": 0,
      "type": "text",
      "required": true,
      "enum_ref": "../masters/financial-years.json#/years",
      "description": "Financial year being amended."
    },
    {
      "id": "omonth",
      "column": "Original Month",
      "order": 1,
      "type": "text",
      "required": true,
      "enum_ref": "../masters/months.json#/names",
      "description": "Month being amended, spelled out in capitals."
    },
    {
      "id": "pos",
      "column": "Place Of Supply",
      "order": 2,
      "type": "state_code",
      "required": true,
      "constraints": [
        "pos_code_range"
      ],
      "transform": "state_code_prefix",
      "description": "Place of supply as 'NN-Name'; only the numeric prefix is kept."
    },
    {
      "id": "rt",
      "column": "Rate",
      "order": 3,
      "type": "decimal",
      "required": true,
      "enum_ref": "../masters/tax-rates.json#/item",
      "description": "Combined tax rate for this line, in percent."
    },
    {
      "id": "txval",
      "column": "Taxable Value",
      "order": 4,
      "type": "decimal",
      "required": true,
      "pattern": "^(\\d{0,11})(\\.\\d{0,2})?$",
      "round_to": 2,
      "description": "Corrected taxable value at this rate."
    },
    {
      "id": "csamt",
      "column": "Cess Amount",
      "order": 5,
      "type": "decimal",
      "required": false,
      "default": 0,
      "pattern": "^(\\d{0,11})(\\.\\d{0,2})?$",
      "round_to": 2,
      "description": "Cess on this line. Must be an explicit 0 when there is none \u2014 see the quirk note."
    }
  ],
  "rules": [],
  "grouping": {
    "invoice_key": [
      "pos",
      "fy",
      "omonth"
    ],
    "item_key": [
      "rt"
    ],
    "item_conflict": "last_wins",
    "invoice_field_conflict": "error"
  },
  "output": {
    "invoice": {
      "keys": [
        {
          "key": "sply_ty",
          "from": "derive:gstr1.supply_type",
          "description": "'INTER' or 'INTRA', from the place of supply against the filer's own state."
        },
        {
          "key": "omon",
          "from": "derive:gstr1.original_period",
          "description": "The MMYYYY period being amended."
        },
        {
          "key": "pos",
          "from": "field:pos"
        },
        {
          "key": "flag",
          "from": "literal:N",
          "description": "Stamped on every e-commerce record; no column supplies it."
        },
        {
          "key": "itms",
          "from": "nested:item"
        }
      ]
    },
    "item": {
      "keys": [
        {
          "key": "rt",
          "from": "field:rt"
        },
        {
          "key": "txval",
          "from": "field:txval"
        },
        {
          "key": "iamt",
          "from": "derive:gstr1.tax_split_by_pos",
          "omit_when_empty": true
        },
        {
          "key": "camt",
          "from": "derive:gstr1.tax_split_by_pos",
          "omit_when_empty": true
        },
        {
          "key": "samt",
          "from": "derive:gstr1.tax_split_by_pos",
          "omit_when_empty": true
        },
        {
          "key": "csamt",
          "from": "derive:gstr1.cess"
        }
      ]
    },
    "derivations": [
      "gstr1.original_period",
      "gstr1.supply_type",
      "gstr1.tax_split_by_pos",
      "gstr1.cess"
    ],
    "derivation_notes": {
      "gstr1.item_num": "num = rt * 100 + 1.",
      "gstr1.supply_type": "'INTRA' when the place of supply is the filer's own state and the filer is not an SEZ unit.",
      "gstr1.tax_split_by_pos": "Intra-state: camt = samt = round(txval * rt * 0.005, 2). Inter-state: iamt = round(txval * rt * 0.01, 2).",
      "gstr1.cess": "csamt = round(Cess Amount, 2), or 0 when blank.",
      "gstr1.original_period": "omon = the MMYYYY period named by the financial year and the spelled-out original month."
    }
  },
  "notes": [
    {
      "kind": "quirk",
      "text": "A BLANK CESS AMOUNT IS REPORTED AS A MISSING HEADER COLUMN \u2014 the presence check reads the parsed ROW, and blank cells are omitted by the reader. Every row needs an explicit 0. This implementation defaults a blank to 0 instead.",
      "affects": [
        "csamt"
      ]
    },
    {
      "kind": "quirk",
      "text": "Every record carries flag: \"N\", written unconditionally with no column behind it.",
      "affects": [
        "output"
      ]
    },
    {
      "kind": "quirk",
      "text": "Records sit at the top level with no envelope, and flag is emitted BEFORE the items rather than after them \u2014 the reverse of every other e-commerce section. Items are bare, with the rate before the taxable value.",
      "affects": [
        "output"
      ]
    }
  ]
}